# DEMO.D1 — isolated demo environment (database zamk_demo, bucket zamk-demo, backend :8090).
# Copy to backend/demo/.env (git-ignored) and fill the values marked CHANGE-ME. Nothing here is a real secret.
APP_ENV=local
APP_PORT=8090
PUBLIC_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:8090
SHOP_PUBLIC_URL=http://localhost:3100

POSTGRES_DSN=postgres://CHANGE-ME-USER:CHANGE-ME-PASSWORD@localhost:5433/zamk_demo?sslmode=disable
POSTGRES_DB=zamk_demo

# same Redis server as dev, but a separate logical DB so rate-limit/session keys never mix
REDIS_ADDR=localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=5

JWT_ACCESS_SECRET=CHANGE-ME-demo-access-secret
JWT_REFRESH_SECRET=CHANGE-ME-demo-refresh-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3102,http://127.0.0.1:3102
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN_LOCAL=true

S3_ENDPOINT=localhost
S3_PORT=9000
S3_REGION=default
S3_BUCKET=zamk-demo
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/zamk-demo
S3_UPLOAD_MAX_SIZE_MB=10

# no external services in the demo
TBANK_TPAY_ENABLED=false
TBANK_TPAY_MODE=mock
VISION_ENABLED=false
CLOUD_RU_API_KEY=
OPENAI_API_KEY=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
MEDIA_CLEANUP_ENABLED=false
AUCTION_MAINTENANCE_ENABLED=false

# seed-only variables (read by `demo.sh seed`, ignored by the backend)
DEMO_DATABASE_URL=postgres://CHANGE-ME-USER:CHANGE-ME-PASSWORD@localhost:5433/zamk_demo?sslmode=disable
DEMO_ACCOUNT_PASSWORD=CHANGE-ME-at-least-12-chars
DEMO_S3_ENDPOINT=localhost:9000
DEMO_S3_ACCESS_KEY=CHANGE-ME
DEMO_S3_SECRET_KEY=CHANGE-ME
OBSERVABILITY_ENABLED=false
