{
  "name": "zamk-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "observability:up": "docker-compose -f infra/observability/docker-compose.observability.yml up -d",
    "observability:down": "docker-compose -f infra/observability/docker-compose.observability.yml down",
    "observability:check": "bash infra/observability/scripts/check.sh",
    "observability:smoke": "bash infra/observability/scripts/smoke.sh",
    "dev:shop": "npm run dev --workspace=shop",
    "dev:seller": "npm run dev --workspace=seller",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:seed": "cd backend && go run ./cmd/dev-seed",
    "build:shop": "npm run build --workspace=shop",
    "build:seller": "npm run build --workspace=seller",
    "build:admin": "npm run build --workspace=admin",
    "build:backend": "cd backend && go build ./cmd/...",
    "build": "npm run build --workspaces --if-present",
    "test:backend": "bash backend/scripts/safe_go_test.sh",
    "test:migrations": "cd backend && bash scripts/test_migrations_clean.sh",
    "check:seller": "npm run test --workspace=seller && npm run build --workspace=seller",
    "check:admin": "npm run test --workspace=admin && npm run build --workspace=admin",
    "check:shop": "npm run test --workspace=shop && npm run build --workspace=shop"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1"
  }
}
