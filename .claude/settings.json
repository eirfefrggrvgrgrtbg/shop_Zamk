
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(gofmt *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(psql *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git apply *)",
      "Bash(git am *)",
      "Bash(git update-index *)",
      "Bash(git stash push *)",
      "Bash(git stash save *)",
      "Bash(git stash pop *)",
      "Bash(git stash apply *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git stash branch *)",
      "Bash(bash .agents/scripts/finalize.sh *)",
      "Bash(sh .agents/scripts/finalize.sh *)",
      "Bash(./.agents/scripts/finalize.sh *)",
      "Bash(migrate *)",
      "Bash(go run github.com/golang-migrate/migrate *)",
      "Bash(go run ./cmd/dev-seed *)",
      "Bash(bash backend/scripts/test_migrations_clean.sh *)",
      "Bash(dropdb *)",
      "Bash(createdb *)",
      "Bash(pg_restore *)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/cookies.txt)",
      "Read(./**/payload.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./backend/main)",
      "Read(./backend/api)",
      "Read(~/.ssh/**)"
    ]
  }
}
